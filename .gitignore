target/

node_modules/

# Private keys and credentials: never commit them
/.keys/
.env
.env.local
.env.*.local
*.keypair.json
# what cargo build-sbf generates next to the .so: a program keypair is a private key
*-keypair.json

# Local scratch: fetched reference trees and caches (never tracked)
/.cache/
/reference/
