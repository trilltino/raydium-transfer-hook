/target/
.DS_Store
Thumbs.db

# Build output of the standalone starter, and of any hook you copy out of it
/starter/target/
/templates/*/target/
/my-hook/

# Quarantined legacy code: regenerated lockfiles and dependencies
/legacy/Cargo.lock
/legacy/target/
/legacy/transfer-hook-client/package-lock.json
node_modules/

# Private keys and credentials: never commit them
/.keys/
.env
.env.local
.env.*.local
*.keypair.json

# Local scratch: fetched reference trees and caches (never tracked)
/.cache/
/reference/
