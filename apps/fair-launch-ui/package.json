{
  "name": "@raydium-transfer-hook/fair-launch-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Fair Launch reference UI: swap a hooked token on an experimental hook-aware Raydium deployment. GPL-3.0-or-later because it uses the Raydium SDK.",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "generate": "node scripts/generate-environments.mjs",
    "predev": "npm run generate",
    "dev": "vite",
    "prebuild": "npm run generate",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "pretest": "npm run generate",
    "pretypecheck": "npm run generate"
  },
  "dependencies": {
    "@raydium-io/raydium-sdk-v2": "0.2.73-alpha",
    "@raydium-transfer-hook/client": "*",
    "@solana/spl-token": "0.4.15",
    "@solana/wallet-adapter-base": "0.9.27",
    "@solana/wallet-adapter-phantom": "^0.9.28",
    "@solana/wallet-adapter-react": "0.15.39",
    "@solana/wallet-adapter-solflare": "^0.6.32",
    "@solana/web3.js": "1.98.4",
    "bn.js": "^5.2.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bn.js": "^5.1.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.7.0",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
