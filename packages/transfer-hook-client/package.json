{
  "name": "@raydium-transfer-hook/client",
  "version": "0.1.0",
  "private": true,
  "description": "Hook-aware Raydium client: resolves each transfer leg's Transfer Hook accounts and builds swap_base_input_v2 / swap_v3. Apache-2.0, no Raydium SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@solana/spl-token": "0.4.15",
    "@solana/web3.js": "1.98.4"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "~5.8",
    "vitest": "^3.2.7"
  }
}
